{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local Minecraft Room",
  "version": "0.0.0",
  "identifier": "com.localminecraftroom.desktop",
  "build": {
    "frontendDist": [
      "../index.html",
      "../styles.css",
      "../bridge.js",
      "../state.js",
      "../app.js"
    ]
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Local Minecraft Room",
        "width": 1180,
        "height": 820,
        "minWidth": 980,
        "minHeight": 680
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'"
    }
  },
  "bundle": {
    "active": false
  }
}
